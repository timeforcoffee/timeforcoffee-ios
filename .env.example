# TestFlight Upload Configuration
# Copy this file to .env and fill in your values

# Option 1: Apple ID Authentication
APPLE_ID=your@email.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option 2: App Store Connect API Key (recommended)
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY_PATH=~/.keys/AuthKey_XXXXXXXXXX.p8

# Keychain unlock (for CI/CD or headless builds)
# Prevents codesign from hanging waiting for keychain password prompt
# KEYCHAIN_PASSWORD=your-login-keychain-password
# KEYCHAIN_PATH=~/Library/Keychains/login.keychain-db
